{
  "title": "Llama.cpp",
  "description": "A lightning-fast Llama.cpp Worker",
  "type": "serverless",
  "category": "language",
  "iconUrl": "https://raw.githubusercontent.com/cemalgnlts/runpod-worker-llama/refs/heads/main/icon.png",
  "config": {
    "runsOn": "GPU",
    "endpointType": "LB",
    "gpuCount": 1,
    "gpuIds": "AMPERE_16,AMPERE_24,ADA_24",
    "containerDiskInGb": 25,
    "presets": [],
    "env": [
      {
        "key": "LLAMA_ARG_HF_REPO",
        "input": {
          "name": "Model HF repo",
          "type": "string",
          "description": "Hugging Face model repository; quant is optional, case-insensitive, default to Q4_K_M, <user>/<model>[:quant]",
          "default": "unsloth/Qwen3.5-9B-MTP-GGUF:UD-Q4_K_XL",
          "advanced": false
        }
      },
      {
        "key": "LLAMA_ARG_ALIAS",
        "input": {
          "name": "Model alias",
          "type": "string",
          "description": "Alias for the model",
          "default": "qwen3.5-9b",
          "advanced": false
        }
      },
      {
        "key": "LLAMA_ARG_N_PARALLEL",
        "input": {
          "name": "Parallel Requests",
          "type": "number",
          "description": "Number of parallel request slots; context is split evenly between them",
          "default": 4,
          "advanced": true,
          "min": 1,
          "max": 16
        }
      }
    ]
  }
}
